{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:best-practices",
        "schedule:weekly"
    ],
    "timezone": "America/Chicago",
    "minimumReleaseAge": "7 days",
    "labels": ["dependencies"],
    "packageRules": [
        {
            "description": "No automated major bumps for framework anchors",
            "matchPackageNames": ["laravel/framework", "filament/forms"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        }
    ]
}
